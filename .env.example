# Copy to .env for local dev, and add the same values in Vercel > Settings > Environment Variables.

# --- Public (browser-safe, shipped in the client bundle) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Build-time only. nitro auto-detects most hosts; set this to force a target.
# NITRO_PRESET="vercel"

# --- Server-side (never exposed to the browser) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="your-project-ref"

# Required by admin/faculty server functions, summary writes and the handwriting archive.
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI (pick ONE) ---
# 1. OpenAI:
# OPENAI_API_KEY="sk-..."
# AI_TEXT_MODEL="gpt-4o-mini"
# 2. Google AI:
# GOOGLE_GENERATIVE_AI_API_KEY="..."
# AI_TEXT_MODEL="gemini-3.8-flash"
# 3. Any other OpenAI-compatible endpoint:
# AI_BASE_URL="https://..."
# AI_API_KEY="..."
# AI_TEXT_MODEL="..."
